{% extends "base.html" %}
{% block content %}
<div class="form-box" style="margin-top: 20px;">
    <h2 style="font-family: Georgia, serif; margin-bottom: 5px; font-size: 28px; font-weight: 400; color: #1c1c1c;">Log In</h2>
    <p style="font-size: 13px; color: #767676; margin-bottom: 30px;">Sign in to manage your wardrobe listings, track marketplace payouts, and ship items.</p>
    
    <form action="/login" method="POST">
        <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" required>
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn-submit" style="margin-top: 10px;">Sign In</button>
    </form>
    <p style="font-size: 13px; color: #767676; margin-top: 25px; text-align: center;">
        New to our marketplace? <a href="/signup" style="color: #1c1c1c; font-weight: 600; text-decoration: none;">Create a Seller Account</a>
    </p>
</div>
{% endblock %}
